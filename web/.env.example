# Copy this file to .env.local for local development, or set these in Vercel.
# Supabase project URL and publishable key are public identifiers, not secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. This elevated key is used for the private AI quota RPC only.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Server only. Never prefix this key with NEXT_PUBLIC_ or commit its real value.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
